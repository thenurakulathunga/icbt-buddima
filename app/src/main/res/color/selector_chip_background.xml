<?xml version="1.0" encoding="utf-8"?>
<!-- Choice chip fill: primary when selected, primary container otherwise, surface variant when disabled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorSurfaceVariant" android:state_enabled="false" />
    <item android:color="?attr/colorPrimary" android:state_checked="true" />
    <item android:color="?attr/colorPrimaryContainer" />
</selector>
