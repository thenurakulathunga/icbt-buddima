<?xml version="1.0" encoding="utf-8"?>
<!-- Edit profile (S31): avatar with change photo, name, email, mobile and a sticky Save button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.printxpress.app.ui.components.AppTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_title="@string/edit_profile_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Widget.PrintXpress.ScreenContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgAvatar"
                android:layout_width="@dimen/avatar_lg"
                android:layout_height="@dimen/avatar_lg"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/cd_avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/img_avatar_placeholder"
                app:shapeAppearance="@style/ShapeAppearance.PrintXpress.Circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhoto"
                style="@style/Widget.PrintXpress.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/change_photo"
                app:icon="@drawable/ic_camera" />

            <com.printxpress.app.ui.components.PxTextInput
                android:id="@+id/inputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:px_inputType="name"
                app:px_label="@string/label_full_name"
                app:px_maxLength="60"
                app:px_startIcon="@drawable/ic_person" />

            <com.printxpress.app.ui.components.PxTextInput
                android:id="@+id/inputEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:px_helper="@string/helper_contact"
                app:px_inputType="email"
                app:px_label="@string/label_email"
                app:px_startIcon="@drawable/ic_mail" />

            <com.printxpress.app.ui.components.PxTextInput
                android:id="@+id/inputPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:px_hint="@string/hint_phone"
                app:px_inputType="phone"
                app:px_label="@string/label_phone"
                app:px_startIcon="@drawable/ic_phone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.printxpress.app.ui.components.StickyBottomBar
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_buttonText="@string/action_save" />
</LinearLayout>
