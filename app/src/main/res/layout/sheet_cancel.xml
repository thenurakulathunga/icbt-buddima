<?xml version="1.0" encoding="utf-8"?>
<!-- Cancel sheet (S20): reason radio list, optional note, error line and confirm button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_lg"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/space_lg"
    android:paddingBottom="@dimen/space_lg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cancel_title"
        android:textAppearance="@style/TextAppearance.PrintXpress.TitleLarge" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxs"
        android:text="@string/cancel_subtitle"
        android:textAppearance="@style/TextAppearance.PrintXpress.Body.Secondary" />

    <RadioGroup
        android:id="@+id/groupReasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/reasonMistake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="@string/cancel_reason_mistake" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/reasonChange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="@string/cancel_reason_change" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/reasonDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="@string/cancel_reason_date" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/reasonPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="@string/cancel_reason_price" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/reasonOther"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="@string/cancel_reason_other" />
    </RadioGroup>

    <TextView
        android:id="@+id/txtReasonError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/err_reason_required"
        android:textAppearance="@style/TextAppearance.PrintXpress.Error"
        android:visibility="gone" />

    <com.printxpress.app.ui.components.PxTextInput
        android:id="@+id/inputNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        app:px_inputType="multiline"
        app:px_label="@string/label_cancel_note"
        app:px_maxLength="200" />

    <com.printxpress.app.ui.components.LoadingButton
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        app:px_style="filled"
        app:px_text="@string/action_confirm_cancel" />
</LinearLayout>
