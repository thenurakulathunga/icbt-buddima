<?xml version="1.0" encoding="utf-8"?>
<!-- PromoCard content: promo gradient (or banner image), title, description and a tap-to-copy code chip; text is #1F2024 on the gradient (docs/05 §3.4). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="com.google.android.material.card.MaterialCardView">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imgBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_gradient_promo" />

        <ImageView
            android:id="@+id/imgDecor"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/space_md"
            android:alpha="0.25"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_gift"
            app:tint="@color/px_ink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/promo_text_end"
            android:paddingBottom="@dimen/space_lg">

            <TextView
                android:id="@+id/txtTag"
                style="@style/Widget.PrintXpress.Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/badge_offer" />

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.PrintXpress.HeadlineSmall"
                android:textColor="@color/px_ink" />

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.PrintXpress.BodySmall"
                android:textColor="@color/px_ink" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCode"
                style="@style/Widget.PrintXpress.Chip.Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:chipBackgroundColor="@color/px_on_dark"
                app:chipIcon="@drawable/ic_copy"
                app:chipIconTint="@color/px_ink"
                app:ensureMinTouchTargetSize="true"
                android:textColor="@color/px_ink" />
        </LinearLayout>
    </FrameLayout>
</merge>
