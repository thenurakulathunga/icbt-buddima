<?xml version="1.0" encoding="utf-8"?>
<!-- QuantityStepper: minus / typed quantity / plus, with an error line (kit Number Input, raised to 48 dp targets). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMinus"
            style="@style/Widget.PrintXpress.Button.Outlined.Small"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/cd_decrease"
            android:padding="0dp"
            app:icon="@drawable/ic_minus"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <EditText
            android:id="@+id/editQty"
            android:layout_width="88dp"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginEnd="@dimen/space_xs"
            android:background="@drawable/bg_stepper_field"
            android:gravity="center"
            android:hint="@string/quantity_label"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="6"
            android:textAppearance="@style/TextAppearance.PrintXpress.TitleSmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlus"
            style="@style/Widget.PrintXpress.Button.Outlined.Small"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/cd_increase"
            android:padding="0dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxs"
        android:textAppearance="@style/TextAppearance.PrintXpress.Error"
        android:visibility="gone" />
</merge>
