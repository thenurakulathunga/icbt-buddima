<?xml version="1.0" encoding="utf-8"?>
<!-- One onboarding slide: large illustration disc, title and text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <FrameLayout
        android:layout_width="@dimen/illustration_size"
        android:layout_height="@dimen/illustration_size"
        android:background="@drawable/bg_circle_container">

        <ImageView
            android:id="@+id/imgIllustration"
            android:layout_width="@dimen/icon_hero"
            android:layout_height="@dimen/icon_hero"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="?attr/colorPrimary" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.PrintXpress.HeadlineSmall" />

    <TextView
        android:id="@+id/txtText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.PrintXpress.Body.Secondary" />
</LinearLayout>
