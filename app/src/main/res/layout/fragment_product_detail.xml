<?xml version="1.0" encoding="utf-8"?>
<!-- Product detail (S10): hero image, name and tags, description, specifications, price guide, sample designs, sticky Configure bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.printxpress.app.ui.components.AppTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_showBack="true" />

    <com.printxpress.app.ui.components.StateLayout
        android:id="@+id/stateLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_lg">

                <com.printxpress.app.ui.components.ArtworkImageView
                    android:id="@+id/imgHero"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/product_hero_height"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_marginEnd="@dimen/space_lg"
                    android:contentDescription="@string/cd_product_image"
                    app:shapeAppearance="@style/ShapeAppearance.PrintXpress.ExtraLarge" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg">

                    <TextView
                        android:id="@+id/txtCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:textAppearance="@style/TextAppearance.PrintXpress.Caption"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/txtName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:textAppearance="@style/TextAppearance.PrintXpress.HeadlineSmall" />

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTurnaround"
                            style="@style/Widget.PrintXpress.Chip.Tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipIcon="@drawable/ic_time" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMinOrder"
                            style="@style/Widget.PrintXpress.Chip.Tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipIcon="@drawable/ic_package" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.printxpress.app.ui.components.SectionHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        app:px_title="@string/detail_description" />

                    <TextView
                        android:id="@+id/txtDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.PrintXpress.Body.Content" />

                    <com.printxpress.app.ui.components.SectionHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        app:px_title="@string/detail_specs" />

                    <com.printxpress.app.ui.components.InfoTableView
                        android:id="@+id/tableSpecs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <com.printxpress.app.ui.components.SectionHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        app:px_title="@string/detail_price_table" />

                    <com.printxpress.app.ui.components.InfoTableView
                        android:id="@+id/tablePrices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/detail_price_table_note"
                        android:textAppearance="@style/TextAppearance.PrintXpress.BodySmall" />

                    <com.printxpress.app.ui.components.SectionHeader
                        android:id="@+id/headerSamples"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        app:px_title="@string/detail_samples" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listSamples"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.printxpress.app.ui.components.StateLayout>

    <com.printxpress.app.ui.components.StickyBottomBar
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_buttonText="@string/action_configure"
        app:px_label="@string/detail_starting" />
</LinearLayout>
