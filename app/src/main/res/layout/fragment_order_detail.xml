<?xml version="1.0" encoding="utf-8"?>
<!-- Order detail and tracking (S18): status header, state banner, timeline, items, fulfilment, payment summary, actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.printxpress.app.ui.components.AppTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_title="@string/order_detail_title" />

    <com.printxpress.app.ui.components.StateLayout
        android:id="@+id/stateLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                style="@style/Widget.PrintXpress.ScreenContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PrintXpress.TitleLarge"
                            android:textIsSelectable="true" />

                        <TextView
                            android:id="@+id/txtPlaced"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:textAppearance="@style/TextAppearance.PrintXpress.BodySmall" />
                    </LinearLayout>

                    <com.printxpress.app.ui.components.StatusBadge
                        android:id="@+id/badgeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <com.printxpress.app.ui.components.InfoBanner
                    android:id="@+id/banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:visibility="gone" />

                <com.printxpress.app.ui.components.SectionHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    app:px_title="@string/section_tracking" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs">

                    <com.printxpress.app.ui.components.OrderTimelineView
                        android:id="@+id/timeline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/space_md" />
                </com.google.android.material.card.MaterialCardView>

                <com.printxpress.app.ui.components.SectionHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    app:px_title="@string/section_order_items" />

                <com.printxpress.app.ui.components.InfoTableView
                    android:id="@+id/tableItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.printxpress.app.ui.components.SectionHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    app:px_title="@string/section_fulfilment" />

                <com.printxpress.app.ui.components.InfoTableView
                    android:id="@+id/tableFulfilment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.printxpress.app.ui.components.SectionHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    app:px_title="@string/section_payment_summary" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs">

                    <com.printxpress.app.ui.components.PriceSummaryView
                        android:id="@+id/priceSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/space_md" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/actionsEditable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:orientation="horizontal">

                    <com.printxpress.app.ui.components.LoadingButton
                        android:id="@+id/btnReschedule"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:layout_weight="1"
                        app:px_icon="@drawable/ic_calendar"
                        app:px_style="outlined"
                        app:px_text="@string/action_reschedule" />

                    <com.printxpress.app.ui.components.LoadingButton
                        android:id="@+id/btnCancel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:layout_weight="1"
                        app:px_style="tonal"
                        app:px_text="@string/action_cancel_order" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtLocked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/locked_helper"
                    android:textAppearance="@style/TextAppearance.PrintXpress.BodySmall"
                    android:visibility="gone" />

                <com.printxpress.app.ui.components.LoadingButton
                    android:id="@+id/btnReorder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:visibility="gone"
                    app:px_icon="@drawable/ic_refresh"
                    app:px_style="filled"
                    app:px_text="@string/action_reorder" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHelp"
                    style="@style/Widget.PrintXpress.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/action_get_help"
                    app:icon="@drawable/ic_nav_support" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.printxpress.app.ui.components.StateLayout>
</LinearLayout>
