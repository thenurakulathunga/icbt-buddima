<?xml version="1.0" encoding="utf-8"?>
<!-- SelectableOptionCard content: icon tile, title/subtitle and a check mark shown when selected. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="com.google.android.material.card.MaterialCardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/list_item_min"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <ImageView
            android:id="@+id/imgIcon"
            android:layout_width="@dimen/icon_tile"
            android:layout_height="@dimen/icon_tile"
            android:background="@drawable/bg_icon_tile"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_sm"
            app:tint="?attr/colorOnPrimaryContainer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.PrintXpress.TitleSmall" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textAppearance="@style/TextAppearance.PrintXpress.BodySmall" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgCheck"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check"
            android:visibility="invisible"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>
</merge>
