<?xml version="1.0" encoding="utf-8"?>
<!-- CategoryCard content: icon tile, category name and product count. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="com.google.android.material.card.MaterialCardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <ImageView
            android:id="@+id/imgIcon"
            android:layout_width="@dimen/icon_tile"
            android:layout_height="@dimen/icon_tile"
            android:background="@drawable/bg_icon_tile"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_sm"
            app:tint="?attr/colorOnPrimaryContainer" />

        <TextView
            android:id="@+id/txtName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.PrintXpress.TitleSmall" />

        <TextView
            android:id="@+id/txtCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:textAppearance="@style/TextAppearance.PrintXpress.BodySmall" />
    </LinearLayout>
</merge>
