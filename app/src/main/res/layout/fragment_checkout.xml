<?xml version="1.0" encoding="utf-8"?>
<!-- Checkout – fulfilment and schedule (S14): Pickup/Delivery cards, branch dropdown or address cards, turnaround note, date and slot picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.printxpress.app.ui.components.AppTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_title="@string/checkout_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Widget.PrintXpress.ScreenContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.printxpress.app.ui.components.SectionHeader
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:px_title="@string/checkout_how" />

            <com.printxpress.app.ui.components.SelectableOptionCard
                android:id="@+id/cardPickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                app:px_icon="@drawable/ic_pickup"
                app:px_subtitle="@string/fulfilment_pickup_sub"
                app:px_title="@string/fulfilment_pickup" />

            <com.printxpress.app.ui.components.SelectableOptionCard
                android:id="@+id/cardDelivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:px_icon="@drawable/ic_delivery"
                app:px_subtitle="@string/fulfilment_delivery_sub"
                app:px_title="@string/fulfilment_delivery" />

            <LinearLayout
                android:id="@+id/sectionPickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.printxpress.app.ui.components.PxDropdown
                    android:id="@+id/dropBranch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    app:px_hint="@string/hint_select"
                    app:px_label="@string/label_branch"
                    app:px_startIcon="@drawable/ic_pickup" />

                <TextView
                    android:id="@+id/txtBranchDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.PrintXpress.BodySmall"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionDelivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.printxpress.app.ui.components.SectionHeader
                    android:id="@+id/headerAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    app:px_actionText="@string/action_add_address"
                    app:px_title="@string/label_delivery_address" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listAddresses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/txtAddressError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.PrintXpress.Error"
                    android:visibility="gone" />
            </LinearLayout>

            <com.printxpress.app.ui.components.SectionHeader
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                app:px_title="@string/checkout_schedule" />

            <com.printxpress.app.ui.components.InfoBanner
                android:id="@+id/bannerTurnaround"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                app:px_type="info" />

            <com.printxpress.app.ui.components.DateSlotPicker
                android:id="@+id/dateSlotPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.printxpress.app.ui.components.StickyBottomBar
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_buttonText="@string/action_review"
        app:px_label="@string/price_total" />
</LinearLayout>
