<?xml version="1.0" encoding="utf-8"?>
<!-- Home (S06): greeting bar with bell/cart, search, promo carousel, categories row, active order, popular products grid, inspiration strip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.printxpress.app.ui.components.AppTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_showActions="true" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/home_subtitle"
                    android:textAppearance="@style/TextAppearance.PrintXpress.Body.Secondary" />

                <com.printxpress.app.ui.components.SearchBarView
                    android:id="@+id/searchBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_marginTop="@dimen/space_sm"
                    android:layout_marginEnd="@dimen/space_lg"
                    app:px_hint="@string/search_products_hint" />

                <com.printxpress.app.ui.components.PromoCarousel
                    android:id="@+id/promoCarousel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg" />

                <com.printxpress.app.ui.components.SectionHeader
                    android:id="@+id/headerCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_md"
                    app:px_actionText="@string/action_see_all"
                    app:px_title="@string/section_categories" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg" />

                <LinearLayout
                    android:id="@+id/sectionActiveOrder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg"
                    android:visibility="gone">

                    <com.printxpress.app.ui.components.SectionHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        app:px_title="@string/section_active_order" />

                    <com.printxpress.app.ui.components.OrderCard
                        android:id="@+id/cardActiveOrder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" />
                </LinearLayout>

                <com.printxpress.app.ui.components.SectionHeader
                    android:id="@+id/headerPopular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_md"
                    app:px_actionText="@string/action_see_all"
                    app:px_title="@string/section_popular" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listPopular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg" />

                <com.printxpress.app.ui.components.SectionHeader
                    android:id="@+id/headerInspiration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_md"
                    app:px_actionText="@string/action_see_all"
                    app:px_title="@string/section_inspiration" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listInspiration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
