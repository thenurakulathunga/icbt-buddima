<?xml version="1.0" encoding="utf-8"?>
<!-- FAQs (S27): search bar and expandable questions with empty state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.printxpress.app.ui.components.AppTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_title="@string/faqs_title" />

    <com.printxpress.app.ui.components.SearchBarView
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_lg"
        app:px_hint="@string/search_faqs_hint"
        app:px_showFilter="false" />

    <com.printxpress.app.ui.components.StateLayout
        android:id="@+id/stateLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:px_skeletonLayout="@layout/view_skeleton_list">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listFaqs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/space_lg" />
    </com.printxpress.app.ui.components.StateLayout>
</LinearLayout>
