<?xml version="1.0" encoding="utf-8"?>
<!-- PriceSummaryView rows: label on the left, amount on the right; discounts in success text, total in Price style. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/price_items"
            android:textAppearance="@style/TextAppearance.PrintXpress.Body.Secondary" />

        <TextView
            android:id="@+id/valItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PrintXpress.BodyMedium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowBulk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/price_bulk"
            android:textAppearance="@style/TextAppearance.PrintXpress.Body.Secondary" />

        <TextView
            android:id="@+id/valBulk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PrintXpress.BodyMedium"
            android:textColor="@color/px_success_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowPromo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lblPromo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.PrintXpress.Body.Secondary" />

        <TextView
            android:id="@+id/valPromo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PrintXpress.BodyMedium"
            android:textColor="@color/px_success_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowDelivery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/price_delivery"
            android:textAppearance="@style/TextAppearance.PrintXpress.Body.Secondary" />

        <TextView
            android:id="@+id/valDelivery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PrintXpress.BodyMedium" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        style="@style/Widget.PrintXpress.Divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_sm" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/price_total"
            android:textAppearance="@style/TextAppearance.PrintXpress.TitleMedium" />

        <TextView
            android:id="@+id/valTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PrintXpress.Price" />
    </LinearLayout>
</merge>
