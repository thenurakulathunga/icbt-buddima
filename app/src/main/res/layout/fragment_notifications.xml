<?xml version="1.0" encoding="utf-8"?>
<!-- Notification centre (S21): top bar with Mark all read, permission banner, list with swipe-to-read and states. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.printxpress.app.ui.components.AppTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_title="@string/notifications_title" />

    <com.printxpress.app.ui.components.InfoBanner
        android:id="@+id/bannerPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_md"
        android:visibility="gone"
        app:px_message="@string/permission_denied_banner"
        app:px_type="warning" />

    <com.printxpress.app.ui.components.StateLayout
        android:id="@+id/stateLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:px_skeletonLayout="@layout/view_skeleton_list">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.printxpress.app.ui.components.StateLayout>
</LinearLayout>
