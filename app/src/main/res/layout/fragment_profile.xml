<?xml version="1.0" encoding="utf-8"?>
<!-- Profile (S30): gradient header, guest sign-in, account menu rows and log out. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.printxpress.app.ui.components.AppTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_title="@string/title_profile" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_lg">

            <com.printxpress.app.ui.components.ProfileHeaderView
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.printxpress.app.ui.components.LoadingButton
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_lg"
                android:visibility="gone"
                app:px_style="filled"
                app:px_text="@string/action_sign_in" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_lg"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginEnd="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.printxpress.app.ui.components.MenuRowView
                        android:id="@+id/rowEditProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:px_icon="@drawable/ic_person"
                        app:px_subtitle="@string/menu_edit_profile_sub"
                        app:px_title="@string/menu_edit_profile" />

                    <com.printxpress.app.ui.components.MenuRowView
                        android:id="@+id/rowAddresses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:px_icon="@drawable/ic_location"
                        app:px_subtitle="@string/menu_addresses_sub"
                        app:px_title="@string/menu_addresses" />

                    <com.printxpress.app.ui.components.MenuRowView
                        android:id="@+id/rowDesigns"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:px_icon="@drawable/ic_saved_designs"
                        app:px_subtitle="@string/menu_saved_designs_sub"
                        app:px_title="@string/menu_saved_designs" />

                    <com.printxpress.app.ui.components.MenuRowView
                        android:id="@+id/rowHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:px_icon="@drawable/ic_history"
                        app:px_subtitle="@string/menu_order_history_sub"
                        app:px_title="@string/menu_order_history" />

                    <com.printxpress.app.ui.components.MenuRowView
                        android:id="@+id/rowPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:px_icon="@drawable/ic_lock"
                        app:px_title="@string/menu_change_password" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_lg"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.printxpress.app.ui.components.MenuRowView
                        android:id="@+id/rowSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:px_icon="@drawable/ic_settings"
                        app:px_subtitle="@string/menu_settings_sub"
                        app:px_title="@string/menu_settings" />

                    <com.printxpress.app.ui.components.MenuRowView
                        android:id="@+id/rowLogout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:px_destructive="true"
                        app:px_icon="@drawable/ic_logout"
                        app:px_showChevron="false"
                        app:px_title="@string/menu_logout" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
