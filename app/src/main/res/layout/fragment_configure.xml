<?xml version="1.0" encoding="utf-8"?>
<!-- Configure product (S11): product summary, option chip groups, quantity stepper with hints, live price summary. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.printxpress.app.ui.components.AppTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_title="@string/configure_title" />

    <com.printxpress.app.ui.components.StateLayout
        android:id="@+id/stateLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                style="@style/Widget.PrintXpress.ScreenContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.printxpress.app.ui.components.ArtworkImageView
                        android:id="@+id/imgProduct"
                        android:layout_width="@dimen/thumb_size"
                        android:layout_height="@dimen/thumb_size"
                        android:importantForAccessibility="no"
                        app:shapeAppearance="@style/ShapeAppearance.PrintXpress.Medium" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PrintXpress.TitleMedium" />

                        <TextView
                            android:id="@+id/txtUnit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:textAppearance="@style/TextAppearance.PrintXpress.BodySmall" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/groups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/configure_quantity"
                    android:textAppearance="@style/TextAppearance.PrintXpress.TitleSmall" />

                <com.printxpress.app.ui.components.QuantityStepper
                    android:id="@+id/stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs" />

                <TextView
                    android:id="@+id/txtQtyHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.PrintXpress.BodySmall" />

                <com.printxpress.app.ui.components.InfoBanner
                    android:id="@+id/bannerBulk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    app:px_message="@string/configure_bulk_hint"
                    app:px_type="success" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg">

                    <com.printxpress.app.ui.components.PriceSummaryView
                        android:id="@+id/priceSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/space_md" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.printxpress.app.ui.components.StateLayout>

    <com.printxpress.app.ui.components.StickyBottomBar
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_buttonText="@string/action_continue_design"
        app:px_label="@string/configure_price" />
</LinearLayout>
