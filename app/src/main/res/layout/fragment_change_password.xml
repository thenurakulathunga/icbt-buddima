<?xml version="1.0" encoding="utf-8"?>
<!-- Change password: current, new with strength meter, confirmation, sticky Save. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.printxpress.app.ui.components.AppTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_title="@string/change_password_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Widget.PrintXpress.ScreenContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.printxpress.app.ui.components.PxTextInput
                android:id="@+id/inputCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:px_inputType="password"
                app:px_label="@string/label_current_password"
                app:px_startIcon="@drawable/ic_lock" />

            <com.printxpress.app.ui.components.PxTextInput
                android:id="@+id/inputNew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:px_hint="@string/hint_password"
                app:px_inputType="password"
                app:px_label="@string/label_new_password"
                app:px_startIcon="@drawable/ic_password" />

            <com.printxpress.app.ui.components.PasswordStrengthMeter
                android:id="@+id/strengthMeter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />

            <com.printxpress.app.ui.components.PxTextInput
                android:id="@+id/inputConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:px_inputType="password"
                app:px_label="@string/label_confirm_password"
                app:px_startIcon="@drawable/ic_password" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.printxpress.app.ui.components.StickyBottomBar
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_buttonText="@string/action_save" />
</LinearLayout>
