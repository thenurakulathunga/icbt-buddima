<?xml version="1.0" encoding="utf-8"?>
<!-- Reset password (S05): registered email and mobile, new password with strength meter, confirmation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.printxpress.app.ui.components.AppTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:px_showBack="true" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Widget.PrintXpress.ScreenContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_title"
                android:textAppearance="@style/TextAppearance.PrintXpress.HeadlineSmall" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/reset_subtitle"
                android:textAppearance="@style/TextAppearance.PrintXpress.Body.Secondary" />

            <com.printxpress.app.ui.components.PxTextInput
                android:id="@+id/inputEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                app:px_hint="@string/hint_email"
                app:px_inputType="email"
                app:px_label="@string/label_email"
                app:px_startIcon="@drawable/ic_mail" />

            <com.printxpress.app.ui.components.PxTextInput
                android:id="@+id/inputPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:px_hint="@string/hint_phone"
                app:px_inputType="phone"
                app:px_label="@string/label_phone"
                app:px_startIcon="@drawable/ic_phone" />

            <com.printxpress.app.ui.components.PxTextInput
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:px_hint="@string/hint_password"
                app:px_inputType="password"
                app:px_label="@string/label_new_password"
                app:px_startIcon="@drawable/ic_lock" />

            <com.printxpress.app.ui.components.PasswordStrengthMeter
                android:id="@+id/strengthMeter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />

            <com.printxpress.app.ui.components.PxTextInput
                android:id="@+id/inputConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:px_inputType="password"
                app:px_label="@string/label_confirm_password"
                app:px_startIcon="@drawable/ic_password" />

            <com.printxpress.app.ui.components.LoadingButton
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                app:px_style="filled"
                app:px_text="@string/action_reset" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
