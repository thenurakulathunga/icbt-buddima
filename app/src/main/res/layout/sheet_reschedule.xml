<?xml version="1.0" encoding="utf-8"?>
<!-- Reschedule sheet (S19): title, date and slot picker, Save new date. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_lg"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/space_lg"
    android:paddingBottom="@dimen/space_lg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reschedule_title"
        android:textAppearance="@style/TextAppearance.PrintXpress.TitleLarge" />

    <com.printxpress.app.ui.components.DateSlotPicker
        android:id="@+id/dateSlotPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md" />

    <com.printxpress.app.ui.components.LoadingButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        app:px_style="filled"
        app:px_text="@string/action_confirm_reschedule" />
</LinearLayout>
