<?xml version="1.0" encoding="utf-8"?>
<!-- Authentication graph hosted by AuthActivity: Login, Register, Reset password. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_auth"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.printxpress.app.ui.auth.LoginFragment"
        android:label="@string/action_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_login_to_reset"
            app:destination="@id/resetPasswordFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.printxpress.app.ui.auth.RegisterFragment"
        android:label="@string/action_create_account" />

    <fragment
        android:id="@+id/resetPasswordFragment"
        android:name="com.printxpress.app.ui.auth.ResetPasswordFragment"
        android:label="@string/action_reset" />
</navigation>
