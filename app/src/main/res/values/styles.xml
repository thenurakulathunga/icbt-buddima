<?xml version="1.0" encoding="utf-8"?>
<!-- Shape ladder (docs/05 §6.1) and reusable widget styles (docs/06 §F): buttons, cards, chips, inputs, bars. -->
<resources>
    <style name="ShapeAppearance.PrintXpress.ExtraSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xs</item>
    </style>
    <style name="ShapeAppearance.PrintXpress.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>
    <style name="ShapeAppearance.PrintXpress.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>
    <style name="ShapeAppearance.PrintXpress.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>
    <style name="ShapeAppearance.PrintXpress.ExtraLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>
    <style name="ShapeAppearance.PrintXpress.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_xxl</item>
        <item name="cornerSizeTopRight">@dimen/radius_xxl</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="ShapeAppearance.PrintXpress.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearance.PrintXpress.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearance.PrintXpress.CardTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_lg</item>
        <item name="cornerSizeTopRight">@dimen/radius_lg</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.PrintXpress.Button.Filled" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.PrintXpress.LabelLarge</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PrintXpress.Large</item>
        <item name="backgroundTint">@color/selector_button_filled</item>
        <item name="android:textColor">@color/selector_on_button_filled</item>
        <item name="iconTint">@color/selector_on_button_filled</item>
        <item name="rippleColor">@color/px_on_primary</item>
    </style>

    <style name="Widget.PrintXpress.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.PrintXpress.LabelLarge</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PrintXpress.Large</item>
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="iconTint">?attr/colorOnPrimaryContainer</item>
    </style>

    <style name="Widget.PrintXpress.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.PrintXpress.LabelLarge</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PrintXpress.Large</item>
        <item name="strokeColor">@color/selector_outline_button</item>
        <item name="strokeWidth">@dimen/stroke_focus</item>
        <item name="android:textColor">@color/selector_outline_button</item>
        <item name="iconTint">@color/selector_outline_button</item>
    </style>

    <style name="Widget.PrintXpress.Button.Outlined.Small">
        <item name="shapeAppearance">@style/ShapeAppearance.PrintXpress.Medium</item>
        <item name="android:textAppearance">@style/TextAppearance.PrintXpress.LabelMedium</item>
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
    </style>

    <style name="Widget.PrintXpress.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.PrintXpress.LabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PrintXpress.Medium</item>
    </style>

    <style name="Widget.PrintXpress.Button.Text.Destructive">
        <item name="android:textColor">?attr/colorError</item>
        <item name="iconTint">?attr/colorError</item>
    </style>

    <style name="Widget.PrintXpress.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="iconSize">@dimen/icon_md</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PrintXpress.Pill</item>
    </style>

    <style name="Widget.PrintXpress.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearance">@style/ShapeAppearance.PrintXpress.Large</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">@dimen/stroke_default</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>

    <style name="Widget.PrintXpress.Card.Hero">
        <item name="shapeAppearance">@style/ShapeAppearance.PrintXpress.ExtraLarge</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.PrintXpress.Card.Selectable">
        <item name="strokeColor">@color/selector_selectable_stroke</item>
        <item name="checkedIconTint">?attr/colorPrimary</item>
        <item name="android:checkable">true</item>
    </style>

    <style name="Widget.PrintXpress.Chip.Choice" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearance">@style/ShapeAppearance.PrintXpress.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.PrintXpress.LabelMedium</item>
        <item name="chipBackgroundColor">@color/selector_chip_background</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">@dimen/touch_min</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <style name="Widget.PrintXpress.Chip.Filter" parent="Widget.PrintXpress.Chip.Choice" />

    <style name="Widget.PrintXpress.Chip.Tag" parent="Widget.Material3.Chip.Assist">
        <item name="shapeAppearance">@style/ShapeAppearance.PrintXpress.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.PrintXpress.LabelMedium</item>
        <item name="chipBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="chipIconTint">?attr/colorOnPrimaryContainer</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">@dimen/space_xl</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="Widget.PrintXpress.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeWidth">@dimen/stroke_default</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_focus</item>
        <item name="boxStrokeErrorColor">?attr/colorError</item>
        <item name="errorTextColor">?attr/colorError</item>
        <item name="errorIconDrawable">@null</item>
        <item name="hintEnabled">false</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="endIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="errorTextAppearance">@style/TextAppearance.PrintXpress.Error</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.PrintXpress.BodySmall</item>
        <item name="counterTextAppearance">@style/TextAppearance.PrintXpress.BodySmall</item>
    </style>

    <style name="Widget.PrintXpress.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_focus</item>
        <item name="hintEnabled">false</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="endIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="errorIconDrawable">@null</item>
        <item name="errorTextAppearance">@style/TextAppearance.PrintXpress.Error</item>
    </style>

    <style name="Widget.PrintXpress.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextAppearance">@style/TextAppearance.PrintXpress.TitleLarge</item>
        <item name="titleCentered">false</item>
        <item name="android:minHeight">@dimen/toolbar_height</item>
    </style>

    <style name="Widget.PrintXpress.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurface</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="itemIconTint">@color/selector_nav_item</item>
        <item name="itemTextColor">@color/selector_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.PrintXpress.NavIndicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.PrintXpress.LabelMedium</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.PrintXpress.LabelMedium</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.PrintXpress.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
    </style>

    <style name="Widget.PrintXpress.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabTextAppearance">@style/TextAppearance.PrintXpress.LabelLarge</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <style name="Widget.PrintXpress.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.PrintXpress.Sheet</item>
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>

    <style name="Widget.PrintXpress.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="shapeAppearance">@style/ShapeAppearance.PrintXpress.Large</item>
    </style>

    <style name="Widget.PrintXpress.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.PrintXpress.TitleMedium</item>
    </style>

    <style name="Widget.PrintXpress.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.PrintXpress.BodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.PrintXpress.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">?attr/colorOutlineVariant</item>
    </style>

    <style name="Widget.PrintXpress.ScreenContent" parent="">
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:paddingTop">@dimen/space_md</item>
        <item name="android:paddingBottom">@dimen/space_lg</item>
    </style>

    <style name="Widget.PrintXpress.CounterBadge" parent="">
        <item name="android:layout_gravity">top|end</item>
        <item name="android:layout_marginTop">@dimen/space_xxs</item>
        <item name="android:layout_marginEnd">@dimen/space_xxs</item>
        <item name="android:background">@drawable/bg_counter_badge</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">@dimen/badge_size</item>
        <item name="android:minHeight">@dimen/badge_size</item>
        <item name="android:paddingStart">@dimen/space_xxs</item>
        <item name="android:paddingEnd">@dimen/space_xxs</item>
        <item name="android:textAppearance">@style/TextAppearance.PrintXpress.Caption</item>
        <item name="android:textColor">?attr/colorOnError</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Widget.PrintXpress.Tag" parent="">
        <item name="android:background">@drawable/bg_tag</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:paddingEnd">@dimen/space_xs</item>
        <item name="android:paddingTop">@dimen/space_xxs</item>
        <item name="android:paddingBottom">@dimen/space_xxs</item>
        <item name="android:textAppearance">@style/TextAppearance.PrintXpress.Caption</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <style name="Widget.PrintXpress.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextAppearance.PrintXpress.BodyMedium</item>
    </style>

    <style name="Widget.PrintXpress.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textAppearance">@style/TextAppearance.PrintXpress.BodyMedium</item>
    </style>

    <style name="Widget.PrintXpress.Label" parent="">
        <item name="android:textAppearance">@style/TextAppearance.PrintXpress.LabelSmallBold</item>
        <item name="android:layout_marginBottom">@dimen/space_xs</item>
    </style>
</resources>
