        <item name="colorOnPrimary">@color/px_on_primary</item>
        <item name="colorPrimaryContainer">@color/px_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/px_on_primary_container</item>
        <item name="colorPrimaryDark">@color/px_primary</item>
        <item name="colorSecondary">@color/px_secondary</item>
        <item name="colorOnSecondary">@color/px_on_secondary</item>
        <item name="colorSecondaryContainer">@color/px_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/px_on_secondary_container</item>
        <item name="colorTertiary">@color/px_primary</item>
        <item name="colorError">@color/px_error</item>
        <item name="colorOnError">@color/px_on_error</item>
        <item name="colorErrorContainer">@color/px_error_container</item>
        <item name="colorOnErrorContainer">@color/px_on_error_container</item>
        <item name="android:colorBackground">@color/px_background</item>
        <item name="colorOnBackground">@color/px_on_surface</item>
        <item name="colorSurface">@color/px_surface</item>
        <item name="colorOnSurface">@color/px_on_surface</item>
        <item name="colorSurfaceVariant">@color/px_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/px_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/px_surface</item>
        <item name="colorSurfaceContainerLow">@color/px_surface</item>
        <item name="colorSurfaceContainer">@color/px_surface</item>
        <item name="colorSurfaceContainerHigh">@color/px_surface</item>
        <item name="colorSurfaceContainerHighest">@color/px_surface_variant</item>
        <item name="colorOutline">@color/px_outline</item>
        <item name="colorOutlineVariant">@color/px_outline_variant</item>
        <item name="colorControlNormal">@color/px_on_surface_variant</item>
        <item name="colorControlActivated">@color/px_primary</item>
        <item name="android:textColorPrimary">@color/px_on_surface</item>
        <item name="android:textColorSecondary">@color/px_on_surface_variant</item>
        <item name="android:textColorHint">@color/px_text_disabled</item>

        <item name="android:textViewStyle">@style/Widget.PrintXpress.TextView</item>
        <item name="editTextStyle">@style/Widget.PrintXpress.EditText</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.PrintXpress.DisplaySmall</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.PrintXpress.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.PrintXpress.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.PrintXpress.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.PrintXpress.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.PrintXpress.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.PrintXpress.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.PrintXpress.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.PrintXpress.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.PrintXpress.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.PrintXpress.LabelMedium</item>
