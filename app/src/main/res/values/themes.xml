        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.PrintXpress.ExtraLarge</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.PrintXpress.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.PrintXpress.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.PrintXpress.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.PrintXpress.ExtraLarge</item>

        <item name="materialButtonStyle">@style/Widget.PrintXpress.Button.Filled</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.PrintXpress.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.PrintXpress.Button.Text</item>
        <item name="materialCardViewStyle">@style/Widget.PrintXpress.Card</item>
        <item name="chipStyle">@style/Widget.PrintXpress.Chip.Choice</item>
        <item name="textInputStyle">@style/Widget.PrintXpress.TextInput</item>
        <item name="toolbarStyle">@style/Widget.PrintXpress.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.PrintXpress.BottomNavigation</item>
        <item name="tabStyle">@style/Widget.PrintXpress.TabLayout</item>
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.PrintXpress.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PrintXpress.Dialog</item>
        <item name="snackbarStyle">@style/Widget.PrintXpress.Snackbar</item>

        <item name="android:windowLightStatusBar">@bool/px_light_system_bars</item>
        <item name="android:statusBarColor">@color/px_transparent</item>
        <item name="android:navigationBarColor">@color/px_transparent</item>
        <item name="android:windowBackground">@color/px_background</item>
    </style>

    <style name="Theme.PrintXpress" parent="Base.Theme.PrintXpress" />

    <style name="Theme.PrintXpress.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/px_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/img_logo_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.PrintXpress</item>
    </style>

    <style name="ThemeOverlay.PrintXpress.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.PrintXpress.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="enableEdgeToEdge">false</item>
    </style>

    <style name="ThemeOverlay.PrintXpress.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.PrintXpress.ExtraLarge</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.PrintXpress.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Widget.PrintXpress.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.PrintXpress.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.PrintXpress.Button.Text</item>
        <item name="backgroundTint">@color/px_surface</item>
    </style>

    <style name="ThemeOverlay.PrintXpress.Dialog.Destructive">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.PrintXpress.Button.Text.Destructive</item>
    </style>
</resources>
