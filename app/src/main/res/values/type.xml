<?xml version="1.0" encoding="utf-8"?>
<!-- Roboto Flex type scale (docs/05 §4). Each style points at its static weight file so weights also render on API 24–27. -->
<resources>
    <style name="TextAppearance.PrintXpress" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/roboto_flex_regular</item>
        <item name="fontFamily">@font/roboto_flex_regular</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.PrintXpress.DisplaySmall">
        <item name="android:fontFamily">@font/roboto_flex_extrabold</item>
        <item name="fontFamily">@font/roboto_flex_extrabold</item>
        <item name="android:textSize">32sp</item>
        <item name="lineHeight">40sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.PrintXpress.HeadlineMedium">
        <item name="android:fontFamily">@font/roboto_flex_extrabold</item>
        <item name="fontFamily">@font/roboto_flex_extrabold</item>
        <item name="android:textSize">24sp</item>
        <item name="lineHeight">32sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.PrintXpress.HeadlineSmall">
        <item name="android:fontFamily">@font/roboto_flex_extrabold</item>
        <item name="fontFamily">@font/roboto_flex_extrabold</item>
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">28sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.PrintXpress.TitleLarge">
        <item name="android:fontFamily">@font/roboto_flex_extrabold</item>
        <item name="fontFamily">@font/roboto_flex_extrabold</item>
        <item name="android:textSize">18sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.PrintXpress.TitleMedium">
        <item name="android:fontFamily">@font/roboto_flex_extrabold</item>
        <item name="fontFamily">@font/roboto_flex_extrabold</item>
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">22sp</item>
        <item name="android:letterSpacing">0.005</item>
    </style>

    <style name="TextAppearance.PrintXpress.TitleSmall">
        <item name="android:fontFamily">@font/roboto_flex_bold</item>
        <item name="fontFamily">@font/roboto_flex_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.PrintXpress.LabelSmallBold">
        <item name="android:fontFamily">@font/roboto_flex_bold</item>
        <item name="fontFamily">@font/roboto_flex_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.PrintXpress.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">22sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.PrintXpress.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.PrintXpress.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.PrintXpress.LabelLarge">
        <item name="android:fontFamily">@font/roboto_flex_semibold</item>
        <item name="fontFamily">@font/roboto_flex_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.PrintXpress.LabelMedium">
        <item name="android:fontFamily">@font/roboto_flex_semibold</item>
        <item name="fontFamily">@font/roboto_flex_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.PrintXpress.Caption">
        <item name="android:fontFamily">@font/roboto_flex_semibold</item>
        <item name="fontFamily">@font/roboto_flex_semibold</item>
        <item name="android:textSize">10sp</item>
        <item name="lineHeight">14sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.PrintXpress.Price">
        <item name="android:fontFamily">@font/roboto_flex_extrabold</item>
        <item name="fontFamily">@font/roboto_flex_extrabold</item>
        <item name="android:textSize">18sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.PrintXpress.Body.Secondary" parent="TextAppearance.PrintXpress.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.PrintXpress.Body.Content" parent="TextAppearance.PrintXpress.BodyLarge">
        <item name="android:textColor">@color/px_text_body</item>
    </style>

    <style name="TextAppearance.PrintXpress.Link" parent="TextAppearance.PrintXpress.LabelLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.PrintXpress.Error" parent="TextAppearance.PrintXpress.BodySmall">
        <item name="android:textColor">?attr/colorError</item>
    </style>

    <style name="TextAppearance.PrintXpress.OnBrand" parent="TextAppearance.PrintXpress.BodyMedium">
        <item name="android:textColor">@color/px_on_dark</item>
    </style>

    <style name="TextAppearance.PrintXpress.OnBrand.Headline" parent="TextAppearance.PrintXpress.HeadlineMedium">
        <item name="android:textColor">@color/px_on_dark</item>
    </style>

    <style name="TextAppearance.PrintXpress.OnBrand.Display" parent="TextAppearance.PrintXpress.DisplaySmall">
        <item name="android:textColor">@color/px_on_dark</item>
    </style>
</resources>
