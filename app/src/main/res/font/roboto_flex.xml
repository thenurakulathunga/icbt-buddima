<?xml version="1.0" encoding="utf-8"?>
<!-- Roboto Flex font family built from bundled static instances (400–800); android: and app: attributes cover API 24/25. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/roboto_flex_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/roboto_flex_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/roboto_flex_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/roboto_flex_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/roboto_flex_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/roboto_flex_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/roboto_flex_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/roboto_flex_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/roboto_flex_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/roboto_flex_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />
</font-family>
